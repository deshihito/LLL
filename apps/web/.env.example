# OAuthを実際に開始する場合だけ true にします。
# テスト段階では false のままにすると、ボタン押下時に外部APIを呼びません。
NEXT_PUBLIC_AUTH_ENABLED="false"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://ykqcgmemxwwdqhnokgdz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google AI Studio / Gemini (server only)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY_2="your-gemini-api-key-2"

# NextAuth (Auth.js v5) Configuration
# LinuxやMacであれば `openssl rand -base64 33` などで生成したランダム文字列を設定します
AUTH_SECRET="your-next-auth-secret-key"

# Auth.js canonical URL. Vercel PreviewでもOAuthはこの固定URLを経由します。
# Vercel: https://lll-deshihito.vercel.app
# Local: http://localhost:3000
AUTH_URL="http://localhost:3000"
AUTH_REDIRECT_PROXY_URL="http://localhost:3000/api/auth"
AUTH_TRUST_HOST="true"

# Google OAuth Credentials
# Google Cloud Console (https://console.cloud.google.com/) から取得
# リダイレクトURI設定: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Discord OAuth Credentials
# Discord Developer Portal (https://discord.com/developers/applications) から取得
# リダイレクトURI設定: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"
