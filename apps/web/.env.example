# NextAuth (Auth.js v5) Configuration
# LinuxやMacであれば `openssl rand -base64 33` などで生成したランダム文字列を設定します
AUTH_SECRET="your-next-auth-secret-key"

# Next.js サイトのベースURL (ローカル開発時は通常 http://localhost:3000)
AUTH_URL="http://localhost:3000"

# Google OAuth Credentials
# Google Cloud Console (https://console.cloud.google.com/) から取得
# リダイレクトURI設定: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Discord OAuth Credentials
# Discord Developer Portal (https://discord.com/developers/applications) から取得
# リダイレクトURI設定: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"
